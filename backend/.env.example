# Backend settings for running outside Docker (copy to backend/.env).
DATABASE_URL=postgresql+psycopg://helix:helix@localhost:5432/helix
# --- Groq (used by extraction, reconciliation fallback and Q&A) ---------------------------------
# GROQ_API_KEY: from https://console.groq.com/keys. Keep it in .env only (git-ignored); it is never
#   logged or returned by any endpoint. Check the setup with:  python -m app.llm --smoke-test
# GROQ_MODEL: any Groq chat model id enabled for your key. There is deliberately no default, and
#   nothing in the code depends on a particular model. The model must support JSON mode. Reasoning
#   models spend hidden output tokens; mind your tier's tokens-per-minute / tokens-per-day limits
#   (a full extraction run is roughly 20-30k tokens per bid).
GROQ_API_KEY=
GROQ_MODEL=
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173
DATA_DIR=data
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
VECTOR_SEARCH_LIMIT=20
KEYWORD_SEARCH_LIMIT=20
RRF_K=60
DEFAULT_TOP_K=5
MAX_TOP_K=20
KEYWORD_MIN_TERM_COVERAGE=0.6
EXTRACTION_EVIDENCE_PER_FIELD=4
EXTRACTION_ADDENDUM_EVIDENCE=2
EXTRACTION_MAX_CHUNKS_PER_CALL=14
EXTRACTION_CHUNK_CHAR_LIMIT=1200
EXTRACTION_MAX_OUTPUT_TOKENS=3000
RECONCILIATION_CHUNKS_PER_ADDENDUM=6
RECONCILIATION_LLM_MAX_CHUNKS=8

# Files larger than this (MB) are refused during ingestion and reported
MAX_INGEST_FILE_MB=50
